# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini API Configuration
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional: Comma-separated fallback models on transient 503/429 overload (set to "none" to disable)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# CORS Configuration
# Comma-separated list of allowed frontend origins in production (no trailing slashes).
# In development (NODE_ENV != production), localhost and 127.0.0.1 origins on any port are allowed automatically.
# Example for GitHub Pages + local dev:
# ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yourusername.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Optional: Request timeout in milliseconds for Gemini API calls (default: 35000)
GEMINI_TIMEOUT_MS=35000
